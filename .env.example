# ── Database (Aiven MySQL) ────────────────────────────────────────────────────
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# MUST be a valid standard Base64-encoded key of at least 256 bits (32 decoded bytes).
# Do NOT use Base64URL (no '-' or '_' characters).
# Generate using:
#   Linux/macOS/Git Bash: openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#   Java CLI: java -cp backend/target/classes com.ecommerce.backend.common.security.JwtSecretGenerator
JWT_SECRET=
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# ── Cloudflare R2 (object storage) ───────────────────────────────────────────
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ── Shiprocket ────────────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external

# ── SMTP (email delivery) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Ecommerce Store
RESET_TOKEN_EXPIRY_MINS=30

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-storefront.netlify.app
ADMIN_URL=https://your-admin.netlify.app
CORS_ALLOWED_ORIGINS=https://your-storefront.netlify.app,https://your-admin.netlify.app
NEXT_PUBLIC_API_URL=


# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=50MB
LOG_SQL=OFF
